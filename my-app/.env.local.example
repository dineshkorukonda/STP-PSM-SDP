# Connection string must use a PostgreSQL role that exists on your machine.
#
# Linux / Docker images often use:
#   postgresql://postgres:postgres@localhost:5432/postgres
#
# macOS (Homebrew) usually uses your macOS username, often with no password:
#   postgresql://YOUR_USERNAME@localhost:5432/postgres
#
# Create DB: createdb smartpass
# Then point DATABASE_URL at .../smartpass

# Base URL for QR codes that open /p/{token}. Use http://YOUR_LAN_IP:3000 to scan from a phone.
NEXT_PUBLIC_APP_URL=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# At least 32 characters; used to sign session cookies (generate a random string)
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
